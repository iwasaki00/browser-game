{
  "name": "sort-and-send",
  "version": "0.5.0-A",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "generate:stages": "node scripts/validate-stages.mjs --write",
    "validate:stages": "node scripts/validate-stages.mjs",
    "build": "npm run validate:stages && npm run typecheck && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.12"
  }
}
